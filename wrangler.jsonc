{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "mailpal",
	"compatibility_date": "2025-01-01",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"main": ".svelte-kit/cloudflare/_worker.js",
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"kv_namespaces": [
		{
			"binding": "KV",
			"id": "d2fb6454c4ba4240a7c4ca55d548ed2d"
		}
	],
	"observability": {
		"enabled": true
	}
}
