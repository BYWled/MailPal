{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "mailpal",
	"compatibility_date": "2026-09-07",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"main": ".svelte-kit/cloudflare/_worker.js",
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"routes": [
		{
			"pattern": "email.wled.email",
			"custom_domain": true
		}
	],
	"kv_namespaces": [
		{
			"binding": "KV",
			"id": "3363a32f3a00406980d46ba7f3bf2827"
		}
	],
	"observability": {
		"enabled": true
	}
}
